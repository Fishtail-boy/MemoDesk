<UserControl x:Class="MemoDesk.App.Controls.DateField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="36">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="32" />
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2"
                Background="{DynamicResource SheetBrush}"
                BorderBrush="{DynamicResource RuleBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <TextBox x:Name="TextPart"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         FontSize="13"
                         Foreground="{DynamicResource InkBrush}"
                         CaretBrush="{DynamicResource SealBrush}"
                         PreviewKeyDown="TextPart_PreviewKeyDown"
                         LostKeyboardFocus="TextPart_LostKeyboardFocus" />
                <Button x:Name="DropButton"
                        Grid.Column="1"
                        Width="32"
                        Height="34"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="DropButton_Click"
                        ToolTip="选择日期"
                        Focusable="False">
                    <Path Data="M 2,4 L 10,10 L 2,16" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4"
                          VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <Popup x:Name="DatePopup"
               PlacementTarget="{Binding ElementName=TextPart}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{DynamicResource SheetBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.14" Color="#447290" />
                </Border.Effect>
                <StackPanel>
                    <Calendar x:Name="Calendar"
                              SelectionMode="SingleDate"
                              SelectedDatesChanged="Calendar_SelectedDatesChanged"
                              PreviewMouseLeftButtonUp="Calendar_PreviewMouseLeftButtonUp"
                              PreviewKeyDown="Calendar_PreviewKeyDown"
                              Width="296" Height="246" />
                    <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,6,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="今天" Style="{StaticResource LinkButton}" Click="Today_Click" />
                                <Button Content="明天" Style="{StaticResource LinkButton}" Margin="12,0,0,0" Click="Tomorrow_Click" />
                            </StackPanel>
                            <Button Content="清除" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Click="Clear_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
