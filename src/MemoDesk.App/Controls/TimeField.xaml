<UserControl x:Class="MemoDesk.App.Controls.TimeField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="36">
    <Grid>
        <Border Background="{DynamicResource SheetBrush}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <TextBox x:Name="TextPart" Padding="10,0,30,0" VerticalContentAlignment="Center"
                         Background="Transparent" BorderThickness="0" FontSize="13"
                         Foreground="{DynamicResource InkBrush}" CaretBrush="{DynamicResource AccentBrush}"
                         TextChanged="TextPart_TextChanged" LostKeyboardFocus="TextPart_LostKeyboardFocus"
                         PreviewKeyDown="TextPart_PreviewKeyDown" />
                <Button HorizontalAlignment="Right" Width="30" Background="Transparent" BorderThickness="0"
                        Content="◷" FontSize="18" Focusable="False" ToolTip="选择时间" Click="Open_Click" />
            </Grid>
        </Border>
        <Popup x:Name="TimePopup" PlacementTarget="{Binding ElementName=TextPart}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="Popup_Closed">
            <Border Padding="16" Background="{DynamicResource SheetBrush}" BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="1" CornerRadius="12" MinWidth="264">
                <StackPanel PreviewKeyDown="Panel_PreviewKeyDown">
                    <TextBlock Text="选择时间" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <StackPanel Width="66"><TextBlock Text="时" Style="{StaticResource MetaText}" Margin="0,0,0,4" /><ComboBox x:Name="Hours" Height="36" /></StackPanel>
                        <StackPanel Width="66" Margin="12,0,0,0"><TextBlock Text="分" Style="{StaticResource MetaText}" Margin="0,0,0,4" /><ComboBox x:Name="Minutes" Height="36" /></StackPanel>
                        <StackPanel x:Name="SecondsPanel" Width="66" Margin="12,0,0,0"><TextBlock Text="秒" Style="{StaticResource MetaText}" Margin="0,0,0,4" /><ComboBox x:Name="Seconds" Height="36" /></StackPanel>
                    </StackPanel>
                    <CheckBox x:Name="SecondsToggle" Content="精确到秒" Margin="0,12,0,0"
                              Checked="Seconds_Changed" Unchecked="Seconds_Changed" Foreground="{DynamicResource BodyBrush}" />
                    <ItemsControl x:Name="Shortcuts" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel MaxWidth="286" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding}" Margin="0,3,6,3"
                            Padding="8,5" Style="{StaticResource GhostButton}" Click="Shortcut_Click" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="取消" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                        <Button Content="确定" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Apply_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
