<Window x:Class="MemoDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="备忘助手"
        Height="720" Width="1080"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        FontSize="14"
        Background="{DynamicResource PaperBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：品牌 + 索引标签 -->
        <Border Grid.Row="0" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" Background="{DynamicResource SealBrush}" CornerRadius="8" Margin="0,0,10,0">
                        <TextBlock Text="✓" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="备忘助手" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                    <TextBlock Text="工作碎片与小提醒" FontSize="11" Foreground="{DynamicResource FaintBrush}" Margin="12,2,0,0" />
                </StackPanel>

                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding Navigation}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}"
                                    Style="{StaticResource NavTab}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Key}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- 主面板 -->
        <Border Grid.Row="1"
                Margin="20,16,20,20"
                Style="{StaticResource SheetBorder}"
                CornerRadius="16">
            <ContentControl Content="{Binding CurrentPage}" />
        </Border>
    </Grid>
</Window>
