<UserControl x:Class="MemoDesk.App.Views.RemindersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,26,30,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="提醒" Style="{StaticResource PageTitle}" />
            <TextBlock Text="“已请求/已交接”只表示提醒已交给系统，不代表已经看到。异常与作废的实例会保留在这里。"
                       Style="{StaticResource PageSubtitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <RadioButton Content="未提醒" GroupName="ReminderFilter" IsChecked="True" Style="{StaticResource FilterRadio}"
                             Command="{Binding SetFilterCommand}" CommandParameter="unreminded" />
                <RadioButton Content="已请求" GroupName="ReminderFilter" Style="{StaticResource FilterRadio}"
                             Command="{Binding SetFilterCommand}" CommandParameter="requested" />
                <RadioButton Content="已稍后" GroupName="ReminderFilter" Style="{StaticResource FilterRadio}"
                             Command="{Binding SetFilterCommand}" CommandParameter="snoozed" />
                <RadioButton Content="异常" GroupName="ReminderFilter" Style="{StaticResource FilterRadio}"
                             Command="{Binding SetFilterCommand}" CommandParameter="problem" />
                <RadioButton Content="全部" GroupName="ReminderFilter" Style="{StaticResource FilterRadio}"
                             Command="{Binding SetFilterCommand}" CommandParameter="all" />
            </StackPanel>
            <TextBlock Text="{Binding Message}" Style="{StaticResource MetaText}" Margin="0,8,0,0"
                       Visibility="{Binding Message, Converter={StaticResource NonEmptyToVisible}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <StackPanel>
                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,1">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Stamp}" Padding="4,5" VerticalAlignment="Top" Margin="0,2,12,0">
                                            <TextBlock Text="{Binding TypeText}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Content}" FontSize="13.5" Foreground="{DynamicResource BodyBrush}" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" />
                                                <TextBlock Text="{Binding PlanText}" Style="{StaticResource MetaText}" Margin="10,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource MetaText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="立即提醒"
                                                    Style="{StaticResource GhostButton}"
                                                    Margin="6,0,0,0"
                                                    IsEnabled="{Binding CanRequestNow}"
                                                    Command="{Binding DataContext.RequestNowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="完成"
                                                    Style="{StaticResource GhostButton}"
                                                    Margin="6,0,0,0"
                                                    Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="编辑"
                                                    Style="{StaticResource GhostButton}"
                                                    Margin="6,0,0,0"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock Text="{Binding EmptyHint}"
                           Style="{StaticResource MetaText}"
                           Margin="4,12,0,0"
                           Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVisible}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
