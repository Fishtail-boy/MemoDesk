<UserControl x:Class="MemoDesk.App.Views.MemosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,26,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Grid>
                <TextBlock Text="备忘" Style="{StaticResource PageTitle}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HotkeyText}" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="桌面便签" Style="{StaticResource GhostButton}" Command="{Binding ToggleWidgetCommand}" Margin="0,0,10,0" />
                    <Button Content="记一条" Style="{StaticResource PrimaryButton}" Command="{Binding CaptureCommand}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="随手记下，轻松完成。需要提醒时，把时间一起说出来。" Style="{StaticResource PageSubtitle}" />
            <Grid Margin="0,22,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="当前" GroupName="MemoFilter" IsChecked="True" Style="{StaticResource FilterRadio}"
                             Command="{Binding SetFilterCommand}" CommandParameter="unprocessed" />
                <RadioButton Content="已完成" GroupName="MemoFilter" Style="{StaticResource FilterRadio}"
                             Command="{Binding SetFilterCommand}" CommandParameter="completed" />
                <RadioButton Content="已归档" GroupName="MemoFilter" Style="{StaticResource FilterRadio}"
                             Command="{Binding SetFilterCommand}" CommandParameter="archived" />
                <RadioButton Content="全部" GroupName="MemoFilter" Style="{StaticResource FilterRadio}"
                             Command="{Binding SetFilterCommand}" CommandParameter="all" />
            </StackPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}" Width="210" Height="34"
                         HorizontalAlignment="Right" ToolTip="搜索备忘，按 Enter 查询" AutomationProperties.Name="搜索备忘">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <StackPanel>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SheetBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        CornerRadius="12" Padding="16,14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox VerticalAlignment="Top" Margin="0,2,14,0" ToolTip="标记完成"
                                                  IsChecked="False" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisible}}"
                                                  Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" AutomationProperties.Name="标记备忘完成" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Content}" FontSize="14" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Meta}" Style="{StaticResource MetaText}" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MetaText}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="编辑" Style="{StaticResource GhostButton}" Padding="10,3" FontSize="12" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="···" Style="{StaticResource GhostButton}" Padding="10,3" Margin="6,0,0,0"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Click="OnMore" ToolTip="更多操作">
                                                <Button.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                                 Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="归档" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisible}}"
                                                                  Command="{Binding Tag.ArchiveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                        <MenuItem Header="恢复" Visibility="{Binding IsOpen, Converter={StaticResource InverseBoolToVisible}}"
                                                                  Command="{Binding Tag.ReopenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                        <MenuItem Header="重新整理" Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisible}}"
                                                                  Command="{Binding Tag.RetryParseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                        <MenuItem Header="删除" Command="{Binding Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                <TextBlock Text="{Binding EmptyHint}"
                           Style="{StaticResource MetaText}"
                           Margin="4,12,0,0"
                           Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVisible}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
