<UserControl x:Class="MemoDesk.App.Views.TodosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,26,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="待办" Style="{StaticResource PageTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <RadioButton Content="未完成" GroupName="TodoFilter" IsChecked="True" Style="{StaticResource FilterRadio}"
                             Command="{Binding SetFilterCommand}" CommandParameter="open" />
                <RadioButton Content="已完成" GroupName="TodoFilter" Style="{StaticResource FilterRadio}"
                             Command="{Binding SetFilterCommand}" CommandParameter="completed" />
                <RadioButton Content="全部" GroupName="TodoFilter" Style="{StaticResource FilterRadio}"
                             Command="{Binding SetFilterCommand}" CommandParameter="all" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <StackPanel>
                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,1">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Content}" FontSize="14" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Meta}" Style="{StaticResource MetaText}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="完成" Style="{StaticResource GhostButton}" Padding="10,3" FontSize="12" Margin="6,0,0,0"
                                                    Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisible}}"
                                                    Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="重新打开" Style="{StaticResource GhostButton}" Padding="10,3" FontSize="12" Margin="6,0,0,0"
                                                    Visibility="{Binding IsOpen, Converter={StaticResource InverseBoolToVisible}}"
                                                    Command="{Binding DataContext.ReopenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="编辑" Style="{StaticResource GhostButton}" Padding="10,3" FontSize="12" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="删除" Style="{StaticResource GhostButton}" Padding="10,3" FontSize="12" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock Text="{Binding EmptyHint}"
                           Style="{StaticResource MetaText}"
                           Margin="4,12,0,0"
                           Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVisible}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
