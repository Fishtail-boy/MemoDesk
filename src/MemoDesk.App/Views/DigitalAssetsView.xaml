<UserControl x:Class="MemoDesk.App.Views.DigitalAssetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:domain="clr-namespace:MemoDesk.Core.Domain;assembly=MemoDesk.Core">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="False">
            <TextBlock Text="数字资产" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="＋ 添加资产" Style="{StaticResource PrimaryButton}" Click="Add_Click" />
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="SearchBox" Style="{StaticResource BoxedField}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="搜索数字资产" />
                <TextBlock Text="搜索名称、类型、链接或简介" Style="{StaticResource MetaText}"
                           IsHitTestVisible="False" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock.Visibility>
                        <Binding ElementName="SearchBox" Path="Text.Length" Converter="{StaticResource ZeroToVisible}" />
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
            <ComboBox Grid.Column="1" Width="164" Margin="10,0,0,0"
                      ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedFilter}"
                      DisplayMemberPath="Title" AutomationProperties.Name="按到期状态筛选" />
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}"
                   Margin="0,0,0,10" TextWrapping="Wrap"
                   Visibility="{Binding ErrorText, Converter={StaticResource NonEmptyToVisible}}" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource MetaText}" Margin="0,8,0,0"
                           Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVisible}}" />
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" BorderThickness="1" Margin="0,0,0,8" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Asset.Name}" Foreground="{DynamicResource InkBrush}"
                                                   FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Asset.Category}" Style="{StaticResource MetaText}" Margin="0,3,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding ExpirationText}" Style="{StaticResource NumeralText}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding StatusText}" Margin="0,3,0,0" HorizontalAlignment="Right"
                                                   Visibility="{Binding StatusText, Converter={StaticResource NonEmptyToVisible}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:AssetExpirationStatus.DueSoon}">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:AssetExpirationStatus.Expired}">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="{Binding Asset.Description}" Foreground="{DynamicResource BodyBrush}"
                                               Visibility="{Binding Asset.Description, Converter={StaticResource NonEmptyToVisible}}" />

                                    <Button Grid.Row="2" Click="OpenLink_Click" Tag="{Binding Asset.Link}" ToolTip="{Binding LinkText}"
                                            AutomationProperties.Name="打开资产链接"
                                            Style="{StaticResource LinkButton}" Foreground="{DynamicResource CyanBrush}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,6,12,0"
                                            Visibility="{Binding LinkText, Converter={StaticResource NonEmptyToVisible}}">
                                        <TextBlock Text="{Binding LinkText}" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                        <Button Content="编辑" Style="{StaticResource GhostButton}" Click="Edit_Click" Tag="{Binding Asset}" />
                                        <Button Content="删除" Style="{StaticResource GhostButton}" Click="Delete_Click" Tag="{Binding Asset}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
