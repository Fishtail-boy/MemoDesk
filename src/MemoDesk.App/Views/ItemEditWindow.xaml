<Window x:Class="MemoDesk.App.Views.ItemEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MemoDesk.App.Controls"
        Title="编辑事项"
        Width="520" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI"
        FontSize="14"
        Background="{DynamicResource PaperBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="HeaderText" Text="编辑备忘" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <Border x:Name="TypeBadge" Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="8,2" Margin="10,2,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="TypeText" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                </Border>
            </StackPanel>

            <TextBlock Text="内容" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
            <TextBox x:Name="ContentBox" Style="{StaticResource BoxedField}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="120" VerticalScrollBarVisibility="Auto" />

            <StackPanel x:Name="TodoPanel" Margin="0,12,0,0">
                <TextBlock Text="事项日期（留空表示未安排）" Style="{StaticResource FieldLabel}" />
                <controls:DateField x:Name="ItemDatePicker" Width="150" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel x:Name="MemoPanel" Margin="0,12,0,0">
                <TextBlock Text="备忘日期" Style="{StaticResource FieldLabel}" />
                <controls:DateField x:Name="MemoDatePicker" Width="150" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel x:Name="WorkPanel" Margin="0,12,0,0">
                <TextBlock Text="发生日期" Style="{StaticResource FieldLabel}" />
                <controls:DateField x:Name="WorkDatePicker" Width="150" HorizontalAlignment="Left" />
                <TextBlock Text="开始 / 结束时间（HH:mm，可留空）" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                <StackPanel Orientation="Horizontal">
                    <controls:TimeField x:Name="WorkStartBox" Width="126" />
                    <TextBlock Text="–" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="6,0" />
                    <controls:TimeField x:Name="WorkEndBox" Width="126" />
                </StackPanel>
                <TextBlock Text="结束日期（跨日时填写，可留空）" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                <controls:DateField x:Name="WorkEndDatePicker" Width="150" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel x:Name="ReminderPanel" Margin="0,12,0,0">
                <TextBlock Text="提醒（日期和时间必须同时填写；留空表示不提醒）" Style="{StaticResource FieldLabel}" />
                <StackPanel Orientation="Horizontal">
                    <controls:DateField x:Name="RemindDatePicker" Width="150" />
                    <controls:TimeField x:Name="RemindTimeBox" Width="130" Margin="8,0,0,0" />
                    <Button Content="清除提醒" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="ClearReminder_Click" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="标签（逗号分隔）" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
            <TextBox x:Name="TagsBox" Style="{StaticResource FieldBox}" />

            <TextBlock Text="优先级" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
            <ComboBox x:Name="PriorityBox" Width="150" HorizontalAlignment="Left">
                <ComboBoxItem Content="无" />
                <ComboBoxItem Content="低" />
                <ComboBoxItem Content="中" />
                <ComboBoxItem Content="高" />
            </ComboBox>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" Style="{StaticResource GhostButton}" Margin="0,0,10,0" IsCancel="True" />
                <Button Content="保存" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
