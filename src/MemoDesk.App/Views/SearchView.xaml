<UserControl x:Class="MemoDesk.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,26,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="搜索" Style="{StaticResource PageTitle}" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         Height="34">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <ComboBox Grid.Column="1"
                          Width="110"
                          Margin="10,0,0,0"
                          ItemsSource="{Binding TypeOptions}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedType}" />
                <ComboBox Grid.Column="2"
                          Width="130"
                          Margin="10,0,0,0"
                          ItemsSource="{Binding StatusOptions}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedStatus}" />
                <Button Grid.Column="3"
                        Content="搜索"
                        Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,0"
                        Command="{Binding SearchCommand}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="日期（按各类型业务时间）：" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
                <DatePicker SelectedDate="{Binding FromDate}" Width="130" />
                <TextBlock Text="至" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="8,0" />
                <DatePicker SelectedDate="{Binding ToDate}" Width="130" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="{Binding Hint}" Style="{StaticResource MetaText}" Margin="4,0,0,8" />
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,12" Margin="0,0,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Top" Margin="0,2,12,0">
                                        <TextBlock Text="{Binding TypeText}" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Snippet}" FontSize="14" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource MetaText}" Margin="0,4,0,0">
                                            <Run Text="{Binding TimeText}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding StatusText}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="编辑" Style="{StaticResource GhostButton}" Padding="10,3" FontSize="12"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
