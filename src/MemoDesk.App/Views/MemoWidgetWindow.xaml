<Window x:Class="MemoDesk.App.Views.MemoWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面备忘" Width="300" Height="260" MinWidth="260" MinHeight="60" MaxHeight="520"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" ShowActivated="False"
        Background="{DynamicResource PaperBrush}" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Border CornerRadius="16" Background="{DynamicResource SheetBrush}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="12,10,10,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="DragHandle" Text="⠿" FontSize="19" Cursor="SizeAll" ToolTip="拖动便签"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" MouseLeftButtonDown="Header_MouseLeftButtonDown" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="桌面备忘" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                    <TextBlock x:Name="DateText" Style="{StaticResource MetaText}" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="PinButton" Content="置顶" Style="{StaticResource LinkButton}" FontSize="11" Margin="0,3,9,0" Click="Pin_Click" Focusable="False" />
                    <Button Content="⋯" Style="{StaticResource LinkButton}" FontSize="17" Padding="3,0" Margin="0,0,8,0" Click="More_Click" Focusable="False">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="LockMenuItem" Header="锁定位置" IsCheckable="True" Click="Lock_Click" />
                                <MenuItem x:Name="TodayMenuItem" Header="只显示今日" IsCheckable="True" Click="TodayOnly_Click" />
                                <MenuItem x:Name="CollapseMenuItem" Header="折叠便签" IsCheckable="True" Click="Collapse_Click" />
                                <MenuItem Header="聚焦便签（键盘操作）" Click="FocusWidget_Click" />
                                <Separator />
                                <MenuItem Header="打开备忘工作台" Click="OpenMain_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="×" ToolTip="隐藏桌面备忘" Style="{StaticResource LinkButton}" FontSize="16" Click="Hide_Click" Focusable="False" />
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="BodyPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="12,0,12,0">
                <StackPanel>
                    <ItemsControl x:Name="MemoList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,10" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsOpen, Converter={StaticResource InverseBoolean}, Mode=OneWay}"
                                                  IsEnabled="{Binding IsOpen}" VerticalAlignment="Top" Margin="0,3,0,0"
                                                  ToolTip="标记完成" Focusable="False" Click="Complete_Click" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" MaxHeight="62" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource InkBrush}" />
                                            <TextBlock Text="{Binding Meta}" Style="{StaticResource MetaText}" FontSize="11" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="⋯" Style="{StaticResource LinkButton}" FontSize="15" VerticalAlignment="Top" Focusable="False" Click="More_Click">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="编辑" Click="Edit_Click" />
                                                    <MenuItem Header="归档" Click="Archive_Click" />
                                                    <Separator />
                                                    <MenuItem Header="删除" Click="Delete_Click" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyText" Text="没有待处理的备忘。" Style="{StaticResource MetaText}" Margin="2,18,0,18" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="FooterPanel" Grid.Row="2" Padding="14,8" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
                <Button Content="打开备忘工作台" Style="{StaticResource LinkButton}" FontSize="11" HorizontalAlignment="Left" Click="OpenMain_Click" Focusable="False" />
            </Border>
        </Grid>
    </Border>
</Window>
