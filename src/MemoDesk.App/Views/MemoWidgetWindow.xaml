<Window x:Class="MemoDesk.App.Views.MemoWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="备忘岛" Width="600" Height="310" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="Manual" ShowInTaskbar="False" ShowActivated="False"
        AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True"
        MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave" PreviewKeyDown="Island_KeyDown">
    <Window.Resources>
        <Style x:Key="IslandTab" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" CornerRadius="14" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IslandButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <DataTemplate x:Key="AgendaRow">
            <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="{Binding Time}" Width="66" Foreground="{DynamicResource CyanBrush}" />
                    <Button DockPanel.Dock="Right" Content="编辑" Style="{StaticResource LinkButton}" Click="EditReminder_Click" />
                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,0,8,0"
                               ToolTip="{Binding Content}" Foreground="{DynamicResource InkBrush}" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Island" CornerRadius="24" Background="{DynamicResource PaperBrush}"
            BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid ClipToBounds="True">
            <Grid x:Name="CompactBar">
                <Button x:Name="CompactButton" Click="Compact_Click" PreviewMouseRightButtonUp="IslandMenu_Opening"
                        AutomationProperties.Name="展开备忘岛" Style="{StaticResource IslandButton}" Padding="0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Pill" Background="Transparent" CornerRadius="20" BorderBrush="Transparent" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel x:Name="CompactContents" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="CompactIcon" Text="◉" Width="22" TextAlignment="Center" Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="CompactClock" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="CompactStatus" Foreground="{DynamicResource FaintBrush}" FontSize="11"
                                   Width="52" TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid x:Name="ExpandedPanel" Margin="13,9,13,10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="新建" Style="{StaticResource IslandButton}" Margin="0,0,5,0" Click="Capture_Click" />
                        <Button x:Name="MenuButton" Content="⋯" Style="{StaticResource IslandButton}" Margin="0,0,5,0"
                                Click="More_Click" AutomationProperties.Name="岛设置">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="IslandMenu" Closed="Menu_Closed">
                                    <MenuItem Header="停靠位置">
                                        <MenuItem x:Name="TopDock" Header="屏幕顶部" IsCheckable="True" Tag="top" Click="Dock_Click" />
                                        <MenuItem x:Name="LeftDock" Header="屏幕左侧" IsCheckable="True" Tag="left" Click="Dock_Click" />
                                        <MenuItem x:Name="RightDock" Header="屏幕右侧" IsCheckable="True" Tag="right" Click="Dock_Click" />
                                    </MenuItem>
                                    <MenuItem Header="移到鼠标所在屏幕" Click="MoveToDisplay_Click" />
                                    <MenuItem x:Name="PinMenuItem" Header="置顶" IsCheckable="True" Click="Pin_Click" />
                                    <MenuItem x:Name="KeepOpenMenuItem" Header="保持展开" IsCheckable="True" Click="KeepOpen_Click" />
                                    <MenuItem x:Name="TodayMenuItem" Header="待办只显示今日" IsCheckable="True" Click="TodayOnly_Click" />
                                    <MenuItem x:Name="WeChatMenuItem" Header="微信任务栏提醒" IsCheckable="True" Click="WeChatToggle_Click" />
                                    <MenuItem x:Name="QuotaMenuItem" Header="自动刷新额度并提示重置" IsCheckable="True" Click="QuotaToggle_Click" />
                                    <Separator />
                                    <MenuItem Header="数字资产" Tag="assets" Click="OpenMain_Click" />
                                    <MenuItem Header="设置" Tag="settings" Click="OpenMain_Click" />
                                    <MenuItem Header="隐藏桌面岛" Click="Hide_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Content="⌃" Style="{StaticResource IslandButton}" ToolTip="收起" AutomationProperties.Name="收起备忘岛" Click="Collapse_Click" />
                    </StackPanel>
                    <TextBlock x:Name="ExpandedClock" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}"
                               Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="PanelTitle" Text="备忘" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,6,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="26" />
                    </Grid.ColumnDefinitions>
                    <Button Content="‹" Style="{StaticResource IslandButton}" VerticalAlignment="Center" Tag="-1"
                            AutomationProperties.Name="上一页" Click="PageStep_Click" />
                    <Button Grid.Column="2" Content="›" Style="{StaticResource IslandButton}" VerticalAlignment="Center" Tag="1"
                            AutomationProperties.Name="下一页" Click="PageStep_Click" />

                    <Grid x:Name="PageBody" Grid.Column="1" Margin="8,0" Background="Transparent"
                          PreviewMouseLeftButtonDown="PageBody_MouseDown" PreviewMouseLeftButtonUp="PageBody_MouseUp">
                        <ContentControl x:Name="PreferencesPanel" Visibility="Collapsed" />
                        <Grid x:Name="MemosPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="114" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,11,0">
                                <TextBlock x:Name="OpenCount" FontSize="39" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock x:Name="DateText" Style="{StaticResource MetaText}" />
                                <Button Content="全部备忘" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                        Margin="0,15,0,0" Tag="memos" Click="OpenMain_Click" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource SheetBrush}" CornerRadius="15" Padding="12,4">
                                <ScrollViewer x:Name="BodyPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <ItemsControl x:Name="MemoList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="0,8" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding IsOpen, Converter={StaticResource InverseBoolean}, Mode=OneWay}"
                                                                      IsEnabled="{Binding IsOpen}" VerticalAlignment="Top" Margin="0,3,0,0"
                                                                      ToolTip="标记完成" Click="Complete_Click" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource InkBrush}" />
                                                                <TextBlock Text="{Binding Meta}" Style="{StaticResource MetaText}" FontSize="11" Margin="0,3,0,0" />
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Content="⋯" Style="{StaticResource LinkButton}" FontSize="15" VerticalAlignment="Top" Focusable="False" Click="More_Click">
                                                                <Button.ContextMenu>
                                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Closed="Menu_Closed">
                                                                        <MenuItem Header="编辑" Click="Edit_Click" />
                                                                        <MenuItem Header="归档" Click="Archive_Click" />
                                                                        <Separator />
                                                                        <MenuItem Header="删除" Click="Delete_Click" />
                                                                    </ContextMenu>
                                                                </Button.ContextMenu>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="EmptyText" Text="没有待处理的备忘。" Style="{StaticResource MetaText}" Margin="1,16" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <Grid x:Name="AgendaPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Calendar x:Name="AgendaCalendar" SelectedDatesChanged="AgendaDate_Changed" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="{DynamicResource SheetBrush}" CornerRadius="15" Padding="12,9" Margin="12,0,0,0">
                                <DockPanel>
                                    <TextBlock x:Name="AgendaDateText" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <ItemsControl x:Name="AgendaRows" ItemTemplate="{StaticResource AgendaRow}" />
                                            <TextBlock x:Name="AgendaEmpty" Text="当日没有备忘提醒。" Style="{StaticResource MetaText}" Margin="0,12,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <ScrollViewer x:Name="MessagesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Background="{DynamicResource SheetBrush}" CornerRadius="15" Padding="12,9">
                                    <DockPanel>
                                        <Button x:Name="WeChatButton" DockPanel.Dock="Right" Style="{StaticResource IslandButton}" Click="WeChat_Click" />
                                        <TextBlock x:Name="WeChatStatus" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <Border Background="{DynamicResource SheetBrush}" CornerRadius="15" Padding="12,9" Margin="0,7,0,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="提醒记录" Tag="reminders" Style="{StaticResource LinkButton}" Click="OpenMain_Click" />
                                            <TextBlock Text="到期备忘" Style="{StaticResource SectionTitle}" />
                                        </DockPanel>
                                        <ItemsControl x:Name="MessageRows" ItemTemplate="{StaticResource AgendaRow}" />
                                        <TextBlock x:Name="MessagesEmpty" Text="没有到期的备忘提醒。" Style="{StaticResource MetaText}" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="QuotaPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Background="{DynamicResource SheetBrush}" CornerRadius="15" Padding="12,9">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button x:Name="RefreshQuotaButton" DockPanel.Dock="Right" Content="刷新" Style="{StaticResource IslandButton}" Click="RefreshQuota_Click" />
                                            <TextBlock Text="Codex" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock x:Name="CodexStatus" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                        <ItemsControl x:Name="QuotaRows">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,7,0,0">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Reset}" Style="{StaticResource MetaText}" />
                                                            <TextBlock Text="{Binding Usage}" FontWeight="SemiBold" />
                                                        </DockPanel>
                                                        <ProgressBar Height="3" Margin="0,5,0,0" Minimum="0" Maximum="100" Value="{Binding Remaining}"
                                                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource RuleBrush}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SheetBrush}" CornerRadius="15" Padding="12,9" Margin="0,7,0,0">
                                    <StackPanel>
                                        <TextBlock Text="DeepSeek 余额" Style="{StaticResource SectionTitle}" />
                                        <TextBlock x:Name="DeepSeekStatus" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource CyanBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel x:Name="VaultPanel" Visibility="Collapsed" VerticalAlignment="Center" Margin="12">
                            <TextBlock Text="密码库" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="使用主密码解锁后检索、复制和管理账号。" Style="{StaticResource MetaText}" Margin="0,8,0,14" />
                            <Button Content="打开密码库" Tag="vault" Style="{StaticResource PrimaryButton}" Click="OpenMain_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                        <DockPanel x:Name="AssetsPanel" Visibility="Collapsed">
                            <StackPanel DockPanel.Dock="Top">
                                <Button Content="管理资产" Style="{StaticResource LinkButton}" Tag="assets" Click="OpenMain_Click"
                                        HorizontalAlignment="Right" Margin="0,0,0,5" />
                                <TextBlock x:Name="AssetsStatus" Style="{StaticResource MetaText}" Margin="4,4,4,8"
                                           Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NonEmptyToVisible}}" />
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="AssetRows">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardBorder}" Padding="10,6" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ExpirationText}" Style="{StaticResource NumeralText}" Margin="8,0,0,0" />
                                                        <TextBlock Text="{Binding Asset.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Asset.Name}" />
                                                    </DockPanel>
                                                    <DockPanel Margin="0,3,0,0">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Style="{StaticResource MetaText}" />
                                                        <TextBlock Text="{Binding Asset.Category}" Style="{StaticResource MetaText}" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Asset.Description}" TextWrapping="Wrap" Foreground="{DynamicResource BodyBrush}"
                                                               Visibility="{Binding Asset.Description, Converter={StaticResource NonEmptyToVisible}}" />
                                                    <Button Style="{StaticResource LinkButton}" Foreground="{DynamicResource CyanBrush}" HorizontalAlignment="Left"
                                                            Click="OpenAssetLink_Click" ToolTip="{Binding LinkText}"
                                                            Visibility="{Binding LinkText, Converter={StaticResource NonEmptyToVisible}}">
                                                        <TextBlock Text="{Binding LinkText}" TextTrimming="CharacterEllipsis" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Grid>

                <UniformGrid x:Name="PageTabs" Grid.Row="2" Columns="6" HorizontalAlignment="Center"
                             KeyboardNavigation.TabNavigation="Continue">
                    <Button Content="备忘" Tag="0" Style="{StaticResource IslandTab}" Click="PageTab_Click" />
                    <Button Content="数字资产" Tag="1" Style="{StaticResource IslandTab}" Click="PageTab_Click" />
                    <Button Content="密码库" Tag="2" Style="{StaticResource IslandTab}" Click="PageTab_Click" />
                    <Button Content="日程" Tag="3" Style="{StaticResource IslandTab}" Click="PageTab_Click" />
                    <Button Content="消息" Tag="4" Style="{StaticResource IslandTab}" Click="PageTab_Click" />
                    <Button Content="额度" Tag="5" Style="{StaticResource IslandTab}" Click="PageTab_Click" />
                </UniformGrid>
            </Grid>
        </Grid>
    </Border>
</Window>
