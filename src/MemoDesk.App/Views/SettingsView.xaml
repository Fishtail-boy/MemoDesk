<UserControl x:Class="MemoDesk.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MemoDesk.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,32" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
            <TextBlock Text="所有数据保存在本机；只有提交的原文会发送给 DeepSeek 解析。"
                       Style="{StaticResource PageSubtitle}" />

            <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="捕获" Style="{StaticResource SectionTitle}" FontSize="15" />

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="记一条快捷键" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="HotkeyBox"
                                     Text="{Binding HotkeyText, Mode=OneWay}"
                                     Style="{StaticResource FieldBox}"
                                     Width="260"
                                     Height="34"
                                     IsReadOnly="True"
                                     IsTabStop="True"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     PreviewKeyUp="HotkeyBox_PreviewKeyUp"
                                     LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" />
                            <Button Content="重新绑定"
                                    Style="{StaticResource GhostButton}"
                                    Margin="10,0,0,0"
                                    Click="RebindHotkey_Click" />
                            <Button Content="取消"
                                    Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0"
                                    Visibility="{Binding HotkeyIsRecording, Converter={StaticResource BoolToVisible}}"
                                    Command="{Binding CancelHotkeyRecordingCommand}" />
                            <Button Content="恢复默认"
                                    Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding ResetHotkeyCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding HotkeyHint}" Style="{StaticResource MetaText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="业务时区" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="260" HorizontalAlignment="Left"
                                  IsEditable="True"
                                  ItemsSource="{Binding TimeZoneOptions}"
                                  Text="{Binding TimeZoneId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="DeepSeek 解析" Style="{StaticResource SectionTitle}" FontSize="15" />

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="接口地址" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                    </StackPanel>

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="模型" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ApiModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Width="260" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="API Key（DPAPI 加密保存，仅在填写新值时更新）" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <PasswordBox x:Name="ApiKeyBox" Width="320" Height="32" VerticalContentAlignment="Center" Padding="8,0" PasswordChanged="ApiKeyBox_PasswordChanged" />
                            <Button Content="清除已保存的 Key" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Command="{Binding ClearApiKeyCommand}" />
                        </StackPanel>
                        <TextBlock Text="已保存 API Key" Style="{StaticResource MetaText}" Margin="0,6,0,0"
                                   Visibility="{Binding HasApiKey, Converter={StaticResource BoolToVisible}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,18,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="稍后提醒" Style="{StaticResource SectionTitle}" FontSize="15" />
                        <Button Content="添加选项"
                                HorizontalAlignment="Right"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding AddSnoozeOptionCommand}" />
                    </Grid>
                    <TextBlock Text="1–5 项；相对时长从点击时计算，“明天”按业务时区下一个自然日的指定时刻。"
                               Style="{StaticResource MetaText}" Margin="0,6,0,0" />

                    <CheckBox Content="优先使用 Windows 系统通知"
                              IsChecked="{Binding UseSystemNotifications}"
                              Margin="0,10,0,0"
                              FontSize="12.5"
                              Foreground="{DynamicResource BodyBrush}" />
                    <CheckBox Content="系统通知明确不可用时，允许精致卡片兜底" IsChecked="{Binding AllowFallbackNotifications}"
                              Margin="0,8,0,0" Foreground="{DynamicResource BodyBrush}" />
                    <TextBlock Text="勿扰不会触发额外弹窗；通知交接未知时标为待核对，不重复弹出。"
                               Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Border Style="{StaticResource CardBorder}" Margin="0,12,0,4" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding NotificationStatus}" Foreground="{DynamicResource BodyBrush}" TextWrapping="Wrap" FontSize="12" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="测试系统通知" Style="{StaticResource GhostButton}" Command="{Binding TestNotificationCommand}" />
                                <Button Content="刷新状态" Style="{StaticResource LinkButton}" Margin="12,0,0,0" Command="{Binding RefreshNotificationStatusCommand}" />
                                <Button Content="Windows 通知设置" Style="{StaticResource LinkButton}" Margin="12,0,0,0" Command="{Binding OpenNotificationSettingsCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <CheckBox Content="显示桌面备忘（浅色玻璃 · 蓝青，默认不置顶）" IsChecked="{Binding ShowDesktopWidget}"
                              Margin="0,12,0,8" Foreground="{DynamicResource BodyBrush}" />

                    <ItemsControl ItemsSource="{Binding SnoozeOptions}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FieldBox}"
                                                 VerticalContentAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  Margin="10,0,0,0"
                                                  Height="30"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding DataContext.SnoozeKinds, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Kind"
                                                  SelectedValue="{Binding Kind, Mode=TwoWay}" />
                                        <Grid Grid.Column="2" Margin="10,0,0,0">
                                            <TextBox Text="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FieldBox}"
                                                     ToolTip="分钟数（1–1440）"
                                                     Visibility="{Binding IsRelative, Converter={StaticResource BoolToVisible}}" />
                                            <controls:TimeField Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding IsTomorrow, Converter={StaticResource BoolToVisible}}" />
                                        </Grid>
                                        <Button Grid.Column="3"
                                                Content="删除"
                                                Style="{StaticResource LinkButton}"
                                                Margin="12,0,0,0"
                                                Command="{Binding DataContext.RemoveSnoozeOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="恢复默认选项"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Command="{Binding ResetSnoozeOptionsCommand}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
